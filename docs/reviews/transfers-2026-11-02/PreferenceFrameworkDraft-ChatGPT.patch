+bool copyUnitPreferenceForUnit(CvUnitPreferenceInfo const& kPref,
+	UnitTypes eUnit, UnitClassTypes eUnitClass, UnitCombatTypes eUnitCombat,
+	UnitPreferenceData& kTarget)
