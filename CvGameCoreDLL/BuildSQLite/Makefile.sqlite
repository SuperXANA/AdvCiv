# XANA: 2026-10-27 SQLite C build integration (ChatGPT)
# Invoke from the existing Project directory. Keep Makefile.user machine-local.
# Source manifest: SQLite version-3.7.5 Makefile.in LIBOBJS0.
# https://github.com/sqlite/sqlite/blob/version-3.7.5/Makefile.in
!include Makefile

SQLITE_OBJ_DIR = $(TEMP_TARGET_FILES)\sqlite
SQLITE_LIB = $(SQLITE_OBJ_DIR)\sqlite3.lib
SQLITE_CFLAGS = /nologo /TC /Y- /MD /W3 /DWIN32 /D_WINDOWS /DSQLITE_CORE /DSQLITE_THREADSAFE=1 /DSQLITE_OMIT_LOAD_EXTENSION
!IF "$(TARGET)" == "Debug"
SQLITE_CFLAGS = $(SQLITE_CFLAGS) /Od /Z7 /D_DEBUG
!ELSE
SQLITE_CFLAGS = $(SQLITE_CFLAGS) /O2 /DNDEBUG
!ENDIF

SQLITE_OBJS = \
    $(SQLITE_OBJ_DIR)\alter.obj \
    $(SQLITE_OBJ_DIR)\analyze.obj \
    $(SQLITE_OBJ_DIR)\attach.obj \
    $(SQLITE_OBJ_DIR)\auth.obj \
    $(SQLITE_OBJ_DIR)\backup.obj \
